{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WatchSync",
  "mainBinaryName": "WatchSync",
  "version": "0.2.3",
  "identifier": "com.actuallyakshat.watchsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WatchSync",
        "width": 1040,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Entertainment",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFOTc2ODRGMDJFQ0Q3QjcKUldTMzErd0NUMmlYZnRDOHhERGIxQVVOUk5sMm5Ga2NVeEM3RnRuSlcwSUY5WGRlUTF5SUduVWEK",
      "endpoints": [
        "https://github.com/actuallyakshat/watchsync/releases/latest/download/latest.json"
      ]
    }
  }
}
